{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "crafting-helper",
  "mainBinaryName": "crafting-helper",
  "version": "0.1.0",
  "identifier": "net.exilepact2.crafting-helper",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1422",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Crafting Helper",
        "width": 960,
        "height": 680,
        "minWidth": 600,
        "minHeight": 480,
        "resizable": true
      },
      {
        "label": "overlay",
        "title": "Crafting Helper Overlay",
        "url": "overlay.html",
        "width": 480,
        "height": 168,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
